  "cards": [
    {
      "dot": "cyan",
      "title": "极薄 Pure Runtime（JVM）",
      "items": [
        "import open_ontology 严格只加载 10 模块 / 8,729 行（runtime.py 仅 1,331 行）",
        "纯同步原子账本：仅允许 COMMITTED / REVERTED / REJECTED，无 M2 挂起态",
        "审批、人工任务与 L4 实体消歧统一在 M1 以 WorkCard 对象编排，t1 现场防幻读重算"
      ]
    },
    {
      "dot": "emerald",
      "title": "Design-Time（javac）与外部 AI-FDE",
      "items": [
        "open_ontology.design check / verify 是零 LLM 确定性裁判，选手与裁判物理隔离",
        "外部 agy CLI 自主探库生成声明式映射、只增不破 Overlay 与 L0-L4 Crosswalk 配置",
        "经五关 Crucible + 覆盖率与红队波普尔差分证伪通过（CORROBORATED）方可签发上线"
      ]
    },
    {
      "dot": "rose",
      "title": "六道铁笼门禁与可选扩展剥离",
      "items": [
        "单动作最多写入 1 台外部权威设备（CROSS_DEVICE_WRITE_FORBIDDEN），严禁伪造 2PC",
        "Gate 6 零例外验证：Runtime 对 design / induction / workshop / mcts / mpc 完全不可见",
        "Web 作战台（open_ontology.workshop）与规划器（mcts / mpc）均作为显式按需扩展独立导入"
      ]
    }
  ]
