{
  "mapping_id": "jsherp_p2p_rest_adapter",
  "source_kind": "rest_erp",
  "treat_false_as_null": false,
  "entity_mappings": [
    {
      "source_table": "system_config",
      "target_object_type": "AccountingEntity",
      "row_filters": [],
      "id_transform": {
        "target_field": "entity_id",
        "source_field": "tenantId",
        "kind": "id_prefix",
        "prefix": "ENT-"
      },
      "field_transforms": [
        {
          "target_field": "name",
          "source_field": "companyName",
          "kind": "direct",
          "default": ""
        },
        {
          "target_field": "base_currency",
          "source_field": "base_currency",
          "kind": "const",
          "default": "CNY"
        },
        {
          "target_field": "status",
          "source_field": "status",
          "kind": "enum_map",
          "default": "active",
          "enum_map": {
            "0": "inactive",
            "1": "active",
            "active": "active",
            "inactive": "inactive"
          }
        }
      ]
    },
    {
      "source_table": "supplier",
      "target_object_type": "BusinessParty",
      "row_filters": [
        {
          "field": "type",
          "op": "eq",
          "value": "供应商"
        }
      ],
      "id_transform": {
        "target_field": "party_id",
        "source_field": "id",
        "kind": "id_prefix",
        "prefix": "PTY-"
      },
      "field_transforms": [
        {
          "target_field": "legal_name",
          "source_field": "supplier",
          "kind": "direct",
          "default": ""
        },
        {
          "target_field": "tax_id",
          "source_field": "taxNum",
          "kind": "direct",
          "default": ""
        },
        {
          "target_field": "country_code",
          "source_field": "country",
          "kind": "const",
          "default": "CN"
        },
        {
          "target_field": "status",
          "source_field": "enabled",
          "kind": "enum_map",
          "default": "active",
          "enum_map": {
            "0": "inactive",
            "1": "active",
            "true": "active",
            "false": "inactive",
            "active": "active",
            "inactive": "inactive"
          }
        }
      ]
    },
    {
      "source_table": "supplier",
      "target_object_type": "P2pSupplierProfile",
      "row_filters": [
        {
          "field": "type",
          "op": "eq",
          "value": "供应商"
        }
      ],
      "id_transform": {
        "target_field": "profile_id",
        "source_field": "id",
        "kind": "id_prefix",
        "prefix": "SUP-"
      },
      "field_transforms": [
        {
          "target_field": "payment_terms",
          "source_field": "description",
          "kind": "direct",
          "default": "NET30"
        },
        {
          "target_field": "status",
          "source_field": "enabled",
          "kind": "enum_map",
          "default": "active",
          "enum_map": {
            "0": "inactive",
            "1": "active",
            "true": "active",
            "false": "inactive",
            "active": "active",
            "inactive": "inactive"
          }
        },
        {
          "target_field": "party",
          "source_field": "id",
          "kind": "foreign_key_id",
          "prefix": "PTY-"
        },
        {
          "target_field": "accounting_entity",
          "source_field": "tenantId",
          "kind": "foreign_key_id",
          "prefix": "ENT-"
        }
      ]
    },
    {
      "source_table": "depot_head",
      "target_object_type": "P2pPurchaseOrder",
      "row_filters": [
        {
          "field": "subType",
          "op": "eq",
          "value": "采购订单"
        }
      ],
      "id_transform": {
        "target_field": "po_id",
        "source_field": "id",
        "kind": "id_prefix",
        "prefix": "PO-"
      },
      "field_transforms": [
        {
          "target_field": "po_number",
          "source_field": "number",
          "kind": "direct",
          "default": ""
        },
        {
          "target_field": "ordered_qty",
          "source_field": "operNumber",
          "kind": "direct",
          "default": 0.0
        },
        {
          "target_field": "unit_price",
          "source_field": "unitPrice",
          "kind": "direct",
          "default": 0.0
        },
        {
          "target_field": "amount_total",
          "source_field": "totalPrice",
          "kind": "direct",
          "default": 0.0
        },
        {
          "target_field": "status",
          "source_field": "status",
          "kind": "enum_map",
          "default": "draft",
          "enum_map": {
            "0": "draft",
            "1": "confirmed",
            "2": "confirmed",
            "3": "received",
            "4": "billed",
            "5": "disputed",
            "6": "cancelled",
            "draft": "draft",
            "confirmed": "confirmed",
            "received": "received",
            "billed": "billed",
            "disputed": "disputed",
            "cancelled": "cancelled"
          }
        },
        {
          "target_field": "supplier",
          "source_field": "organId",
          "kind": "foreign_key_id",
          "prefix": "SUP-"
        },
        {
          "target_field": "accounting_entity",
          "source_field": "tenantId",
          "kind": "foreign_key_id",
          "prefix": "ENT-"
        }
      ]
    },
    {
      "source_table": "depot_head",
      "target_object_type": "P2pGoodsReceipt",
      "row_filters": [
        {
          "field": "subType",
          "op": "eq",
          "value": "采购"
        }
      ],
      "id_transform": {
        "target_field": "receipt_id",
        "source_field": "id",
        "kind": "id_prefix",
        "prefix": "GR-"
      },
      "field_transforms": [
        {
          "target_field": "expected_qty",
          "source_field": "preNumber",
          "kind": "direct",
          "default": 0.0
        },
        {
          "target_field": "received_qty",
          "source_field": "operNumber",
          "kind": "direct",
          "default": 0.0
        },
        {
          "target_field": "inspection_status",
          "source_field": "inspection_status",
          "kind": "direct",
          "default": "pending"
        },
        {
          "target_field": "status",
          "source_field": "status",
          "kind": "enum_map",
          "default": "pending",
          "enum_map": {
            "0": "pending",
            "1": "completed",
            "2": "disputed",
            "3": "cancelled",
            "pending": "pending",
            "completed": "completed",
            "disputed": "disputed",
            "cancelled": "cancelled"
          }
        },
        {
          "target_field": "purchase_order",
          "source_field": "linkNumber",
          "kind": "lookup_join",
          "lookup_table": "depot_head",
          "lookup_key_field": "number",
          "lookup_target_type": "P2pPurchaseOrder"
        }
      ]
    },
    {
      "source_table": "depot_head",
      "target_object_type": "P2pVendorBill",
      "row_filters": [
        {
          "field": "subType",
          "op": "eq",
          "value": "采购"
        }
      ],
      "id_transform": {
        "target_field": "bill_id",
        "source_field": "id",
        "kind": "id_prefix",
        "prefix": "BILL-"
      },
      "field_transforms": [
        {
          "target_field": "amount_total",
          "source_field": "totalPrice",
          "kind": "direct",
          "default": 0.0
        },
        {
          "target_field": "amount_residual",
          "source_field": "lastDebt",
          "kind": "direct",
          "default": 0.0
        },
        {
          "target_field": "payment_state",
          "source_field": "payment_state",
          "kind": "enum_map",
          "default": "not_paid",
          "enum_map": {
            "0": "not_paid",
            "1": "partial",
            "2": "paid",
            "not_paid": "not_paid",
            "partial": "partial",
            "paid": "paid"
          }
        },
        {
          "target_field": "status",
          "source_field": "status",
          "kind": "enum_map",
          "default": "draft",
          "enum_map": {
            "0": "draft",
            "1": "posted",
            "2": "cancelled",
            "draft": "draft",
            "posted": "posted",
            "cancelled": "cancelled"
          }
        },
        {
          "target_field": "purchase_order",
          "source_field": "linkNumber",
          "kind": "lookup_join",
          "lookup_table": "depot_head",
          "lookup_key_field": "number",
          "lookup_target_type": "P2pPurchaseOrder"
        }
      ]
    }
  ],
  "action_bindings": [
    {
      "action_name": "confirm_p2p_order",
      "external_table": "depot_head",
      "external_method": "status=confirmed",
      "target_object_type": "P2pPurchaseOrder",
      "id_param": "po_id",
      "id_prefix": "PO-",
      "expected_state_field": "status",
      "expected_state_after": "confirmed"
    },
    {
      "action_name": "record_p2p_receipt",
      "external_table": "depot_head+depot_item",
      "external_method": "operNumber=received_qty;inspection_status=remark",
      "target_object_type": "P2pGoodsReceipt",
      "id_param": "receipt_id",
      "id_prefix": "GR-",
      "expected_state_field": "status",
      "expected_state_after": "completed"
    },
    {
      "action_name": "post_p2p_bill",
      "external_table": "depot_head",
      "external_method": "status=posted",
      "target_object_type": "P2pVendorBill",
      "id_param": "bill_id",
      "id_prefix": "BILL-",
      "expected_state_field": "status",
      "expected_state_after": "posted"
    },
    {
      "action_name": "record_p2p_payment",
      "external_table": "account_head+account_item",
      "external_method": "payment_status=paid",
      "target_object_type": "P2pVendorBill",
      "id_param": "bill_id",
      "id_prefix": "BILL-",
      "expected_state_field": "payment_state",
      "expected_state_after": "paid"
    }
  ]
}